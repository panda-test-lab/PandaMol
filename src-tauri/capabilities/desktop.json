{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only dialogs and app updater access",
  "windows": [
    "main"
  ],
  "platforms": [
    "windows",
    "linux",
    "macOS"
  ],
  "permissions": [
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart"
  ]
}